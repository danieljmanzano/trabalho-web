# Configurações do servidor — copie este arquivo para .env e preencha os valores

# Banco de dados (deixe como está para usar SQLite localmente)
DATABASE_URL=sqlite:///./database.db

# Chave secreta para assinar os tokens JWT
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# Algoritmo JWT (não altere)
ALGORITHM=HS256

# Tempo de expiração do token em minutos (padrão: 1440 = 1 dia)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
